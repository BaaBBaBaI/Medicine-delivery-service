<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.project.controller.MainController"
            styleClass="app-root">

    <top>
        <VBox spacing="10" styleClass="top-header-container">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-bar">
                <Label text="Заказ доставки лекарств" styleClass="app-title"/>
                
                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="dbConnectionBadge" text="БД PostgreSQL: проверка..." styleClass="connection-badge"/>
                <Button text="Клиенты (связанная сущность)" onAction="#handleOpenClientsDialog" styleClass="btn-secondary"/>
                <Button text="Статистика и аналитика" onAction="#handleOpenStatisticsDialog" styleClass="btn-secondary"/>
                <MenuButton text="Экспорт данных" styleClass="btn-secondary">
                    <items>
                        <MenuItem text="Выгрузить в Microsoft Excel (.xlsx)..." onAction="#handleExportExcel"/>
                        <MenuItem text="Выгрузить в CSV (.csv)..." onAction="#handleExportCsv"/>
                    </items>
                </MenuButton>
                <Button text="Инициализация БД" onAction="#handleResetDatabaseDemoData" styleClass="btn-outline"/>
            </HBox>

            <VBox spacing="8" styleClass="toolbar-card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Новый заказ" onAction="#handleAddOrder" styleClass="btn-primary"/>
                    <Button text="Редактировать" onAction="#handleEditOrder" styleClass="btn-action"/>
                    <Button text="Сменить статус" onAction="#handleChangeStatus" styleClass="btn-action"/>
                    <Button text="Удалить заказ" onAction="#handleDeleteOrder" styleClass="btn-danger"/>
                    <Separator orientation="VERTICAL"/>
                    <TextField fx:id="searchField" onAction="#handleApplySearchAndFilters"
                               promptText="Поиск по № заказа, ФИО клиента, телефону, адресу, препаратам или № рецепта..."
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Найти / Применить" onAction="#handleApplySearchAndFilters" styleClass="btn-primary"/>
                    <Button text="Сбросить" onAction="#handleResetFilters" styleClass="btn-outline"/>
                    <Button text="Обновить" onAction="#handleRefreshData" styleClass="btn-outline"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Фильтры:" minWidth="-Infinity" styleClass="filter-label"/>
                    <ComboBox fx:id="statusFilterCombo" onAction="#handleApplySearchAndFilters" prefWidth="175" minWidth="90" promptText="Все статусы"/>
                    <ComboBox fx:id="paymentFilterCombo" onAction="#handleApplySearchAndFilters" prefWidth="205" minWidth="110" promptText="Все способы оплаты"/>
                    <ComboBox fx:id="prescriptionFilterCombo" onAction="#handleApplySearchAndFilters" prefWidth="185" minWidth="90"/>
                    <ComboBox fx:id="clientFilterCombo" onAction="#handleApplySearchAndFilters" prefWidth="210" minWidth="110" promptText="Все клиенты"/>

                    <Label text="Сумма (₽):" minWidth="-Infinity" styleClass="filter-label"/>
                    <TextField fx:id="minAmountField" onAction="#handleApplySearchAndFilters" promptText="От" prefWidth="75" minWidth="45"/>
                    <TextField fx:id="maxAmountField" onAction="#handleApplySearchAndFilters" promptText="До" prefWidth="75" minWidth="45"/>

                    <Label text="Сортировка:" minWidth="-Infinity" styleClass="filter-label"/>
                    <ComboBox fx:id="sortCombo" onAction="#handleApplySearchAndFilters" prefWidth="230" minWidth="120" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="filterErrorLabel" visible="false" managed="false" styleClass="error-banner"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.71" styleClass="main-split-pane">
            <VBox spacing="6" styleClass="table-container">
                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOrderNumber" text="№ Заказа" prefWidth="115"/>
                        <TableColumn fx:id="colClientName" text="Клиент (ФИО)" prefWidth="185"/>
                        <TableColumn fx:id="colPhone" text="Контактный телефон" prefWidth="135"/>
                        <TableColumn fx:id="colAddress" text="Адрес доставки" prefWidth="220"/>
                        <TableColumn fx:id="colAmount" text="Сумма (₽)" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Статус" prefWidth="150"/>
                        <TableColumn fx:id="colPayment" text="Способ оплаты" prefWidth="165"/>
                        <TableColumn fx:id="colPrescription" text="Рецепт (№)" prefWidth="125"/>
                        <TableColumn fx:id="colCreatedAt" text="Создан" prefWidth="125"/>
                        <TableColumn fx:id="colDeliveredAt" text="Доставлен" prefWidth="125"/>
                    </columns>
                    <placeholder>
                        <Label text="Заказы не найдены. Измените параметры фильтрации или нажмите «Инициализация БД»."/>
                    </placeholder>
                </TableView>
            </VBox>

            <ScrollPane fitToWidth="true" styleClass="details-scroll-pane">
                <VBox spacing="12" styleClass="details-card">
                    <Label text="Карточка заказа доставки" styleClass="section-header"/>

                    <GridPane hgap="10" vgap="7">
                        <columnConstraints>
                            <ColumnConstraints minWidth="125" prefWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Номер заказа:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailOrderNumberLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="field-value-bold" wrapText="true"/>

                        <Label text="Статус:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailStatusLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>

                        <Label text="Сумма заказа:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailAmountLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="field-value-bold"/>

                        <Label text="Способ оплаты:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailPaymentLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>

                        <Label text="Рецептурный:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailPrescriptionLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>

                        <Label text="Адрес доставки:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailAddressLabel" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>

                        <Label text="Телефон:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailPhoneLabel" GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="field-value"/>

                        <Label text="Дата создания:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailCreatedLabel" GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="field-value"/>

                        <Label text="Дата вручения:" GridPane.rowIndex="8" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailDeliveredLabel" GridPane.rowIndex="8" GridPane.columnIndex="1" styleClass="field-value"/>
                    </GridPane>

                    <Label text="Состав заказа и примечание для курьера:" styleClass="field-caption"/>
                    <TextArea fx:id="detailNotesArea" editable="false" wrapText="true" prefRowCount="4" styleClass="readonly-textarea"/>

                    <Separator/>

                    <Label text="Связанная сущность: Клиент-заказчик" styleClass="section-header"/>
                    <GridPane hgap="10" vgap="7">
                        <columnConstraints>
                            <ColumnConstraints minWidth="125" prefWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="ФИО клиента:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailClientNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="field-value-bold" wrapText="true"/>

                        <Label text="Телефон:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailClientPhoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="field-value"/>

                        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailClientEmailLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>

                        <Label text="Осн. адрес:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-caption"/>
                        <Label fx:id="detailClientAddressLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="field-value" wrapText="true"/>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="statusBarLabel" text="Система готова к работе." HBox.hgrow="ALWAYS"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalShownLabel" text="Показано заказов: 0" styleClass="status-summary-label"/>
        </HBox>
    </bottom>
</BorderPane>